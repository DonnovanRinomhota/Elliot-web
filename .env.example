# Chat/lead integration mode: "demo" (default, no backend required) or "live"
NEXT_PUBLIC_ELLIOT_MODE=demo

# --- Live chat (only required when MODE=live) ---
# Full n8n production webhook URL for the Main AI Agent (workflow 01).
NEXT_PUBLIC_ELLIOT_CHAT_WEBHOOK_URL=
# Which tenant's data powers the live chat demo (a tenant_slug, e.g. "zebra-dev").
NEXT_PUBLIC_ELLIOT_DEMO_TENANT=

# --- Demo request form (only required when MODE=live) ---
# Full n8n production webhook URL for Demo Request Intake (workflow 18).
NEXT_PUBLIC_ELLIOT_DEMO_REQUEST_WEBHOOK_URL=
